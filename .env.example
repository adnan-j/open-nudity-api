# Leave API_KEY empty to run without authentication (open access)
API_KEY=

# Max images allowed per single request
MAX_IMAGES_PER_REQUEST=10

# Thread pool size for model inference
WORKERS=4

# Detection thresholds (0.0 – 1.0)
# Lower = more sensitive (catches more, risks false positives)
# Higher = more strict  (fewer false positives, may miss edge cases)
# NudeNet scores on real-world photos typically fall in the 0.30–0.55 range.
THRESHOLD_BREAST=0.30
THRESHOLD_GENITALIA=0.30
THRESHOLD_BUTTOCKS=0.40
THRESHOLD_ANUS=0.45
